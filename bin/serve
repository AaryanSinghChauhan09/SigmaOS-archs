#!/usr/bin/env node
// Local preview of the Worker: same routes, plus live reload on index.html changes.
// No dependencies, no build step. Usage: bin/serve [port]

import { createServer } from "node:http";
import { readFile, watch } from "node:fs/promises";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const port = Number(process.argv[2] ?? process.env.PORT ?? 3000);

const IMAGES = {
  "/king.jpeg": "omarch-king.jpeg",
  "/queen.jpeg": "omarch-queen.jpeg",
  "/og.jpeg": "og.jpeg",
};

const RELOAD_SCRIPT = `
<script>
  new EventSource("/__reload").onmessage = () => location.reload();
</script>
`;

const clients = new Set();

const server = createServer(async (request, response) => {
  const { pathname } = new URL(request.url, `http://${request.headers.host}`);

  if (pathname === "/__reload") {
    response.writeHead(200, {
      "content-type": "text/event-stream",
      "cache-control": "no-cache",
      connection: "keep-alive",
    });
    response.write("retry: 500\n\n");
    clients.add(response);
    request.on("close", () => clients.delete(response));
    return;
  }

  if (pathname === "/") {
    const html = await readFile(join(root, "index.html"), "utf8");
    response.writeHead(200, {
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-store",
    });
    return response.end(html + RELOAD_SCRIPT);
  }

  const image = IMAGES[pathname];
  if (image) {
    response.writeHead(200, {
      "content-type": "image/jpeg",
      "cache-control": "no-store",
    });
    return response.end(await readFile(join(root, image)));
  }

  response.writeHead(302, { location: "/" });
  response.end();
});

server.listen(port, () => console.log(`The Omarchs hold court at http://localhost:${port}`));

for await (const event of watch(root)) {
  if (event.filename !== "index.html") continue;
  console.log("index.html changed — reloading");
  for (const client of clients) client.write("data: reload\n\n");
}
